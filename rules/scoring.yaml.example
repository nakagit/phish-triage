# /opt/phish/rules/scoring.yaml
#
# 不審メール判定のスコアリング定義。
# 配点調整はこのファイルだけで行い、Python コードは触らない方針。
#
# label       : 担当者向けの簡潔な表示（技術用語可）
# description : 報告者向けの平易な説明（非技術者が読んで行動できる文面）
#
# 配点の設計方針:
#   - 単独のシグナルで悪性(100点)に到達させない。誤検知1つで断定しないため
#   - 高配点(35〜45)が2〜3つ重なると悪性圏。フィッシングは通常、複数の特徴を持つ
#   - 文脈系(C)は合計しても80点で閾値に届かない。LLM単独では悪性にしない
#   - 脅威インテリ由来(U01/A01/H09/H15)も単独では断定しない。理由は
#     instant_malicious のコメントを参照

# ---- 組織設定 ----
organization:
  # 自組織ドメイン。H08（自組織詐称）、U02（類似ドメイン）、S02（正規通知）で参照。
  # enrich.py では、このドメインを OpenCTI 照会の対象から除外する
  domains:
    - example.ac.jp
    - example.jp
  # サブドメインも自組織として扱うか（例: imc.example.ac.jp）。
  # 判定は末尾一致で行うため、example.ac.jp.evil.com は自組織と誤認しない
  include_subdomains: true

# ---- 閾値 ----
thresholds:
  attached:          # 添付として転送された場合（ヘッダー完全体あり）
    malicious: 100
    suspicious: 50
    unknown: 20
  inline:            # 通常転送（ヘッダー欠落）。
                     # ヘッダー系が原理的に検出できず見逃しやすいため、
                     # 閾値を下げて「疑わしい」側に倒し、人の目を入れる
    malicious: 80
    suspicious: 35
    unknown: 15

# ---- 単独で悪性確定とするルール（スコア積算を待たない）----
#
# 現在は空。当初 U01(既知悪性URL) と A01(既知マルウェア) を
# 即時悪性としていたが、OpenCTI のスコア分布を実測して取り下げた。
#
# 実測値（Domain-Name 約20万件）:
#   score > 0  : 206,730
#   score > 30 : 186,299
#   score > 50 : 186,244   ← 18万件が51〜70に密集
#   score > 70 :   2,002
#   score > 90 :       0
#
# 大半のフィードが既定値のまま投入されており、スコアは信頼性の指標として
# 機能していない。実際 google.com が score=60 で登録されている。
# 即時悪性にすると、誤ヒット1件で報告者に「危険です」と誤通知する事故が
# 起きるため、積算スコアに留めて他のシグナルと組み合わせて判断する。
#
# enrich.py 側でもスコア70超の足切りと、自組織・著名ブランドの
# 照会スキップを行っている。
instant_malicious: []

# ---- 複合条件で悪性確定とする組み合わせ ----
instant_malicious_combo:
  - rules: [H08, H01]
    reason: "自組織ドメインを詐称し、かつ認証にも失敗している"
  # [H01, H13] は正規の小規模事業者（gmail.com を From にして
  # Amazon SES 等から送信）でも成立し得るため無効化している。
  # 積算90点で「疑わしい」となり、担当者の目視確認に回る。
  # 運用データが蓄積し、誤検知が出ないと確認できたら有効化を検討する
  # - rules: [H01, H13]
  #   reason: "フリーメールの差出人を詐称し、配信サービス経由で送信されている"

rules:
  # ==================================================================
  # A. ヘッダー系
  # ==================================================================
  - id: H01
    category: header
    score: 35
    label: "DMARC 認証失敗"
    description: "差出人として表示されているドメインから正式に送られたものではない可能性が高いです。"

  - id: H02
    category: header
    score: 25
    label: "SPF 認証失敗"
    description: "このメールは、差出人のドメインが許可していないサーバーから送信されています。"

  - id: H03
    category: header
    score: 10
    label: "SPF softfail"
    description: "送信元サーバーが差出人のドメインに正式に登録されていません。"

  - id: H04
    category: header
    score: 20
    label: "DKIM 署名検証失敗"
    description: "メールに付与された電子署名の検証に失敗しました。改ざんまたは詐称の可能性があります。"

  - id: H05
    category: header
    score: 20
    label: "From と Return-Path のドメイン不一致"
    description: "表示されている差出人と、実際の送信元が異なっています。"

  - id: H06
    category: header
    score: 30
    label: "Reply-To が From と別ドメイン"
    description: "返信すると、差出人とは別のアドレスに届きます。振込先変更などを装う詐欺でよく使われる手口です。"

  - id: H07
    category: header
    score: 35
    label: "表示名詐称（実在組織名＋フリーメール）"
    description: "実在する企業や部署の名前を表示していますが、メールアドレスは無関係なフリーメールです。"

  - id: H08
    category: header
    score: 40
    label: "自組織ドメインの詐称（外部着信）"
    description: "学内から送られたように見えますが、実際には外部から届いています。"

  # H09 は enrich.py（OpenCTI 照会）が立てる。
  # IPは共有ホスティングで無関係なサイトが巻き込まれやすいため、
  # ドメインやハッシュより配点を低くしている
  - id: H09
    category: header
    score: 25
    label: "送信元IPが既知の悪性インフラ"
    description: "過去に攻撃で使われたことが確認されているサーバーから送信されています。"

  - id: H10
    category: header
    score: 15
    label: "Received チェーンの矛盾"
    description: "メールの配送経路の記録に不自然な点があり、偽造された可能性があります。"

  - id: H11
    category: header
    score: 5
    label: "認証結果ヘッダーなし"
    description: "送信元を検証するための情報が付いていません。"

  - id: H12
    category: header
    score: 20
    label: "署名ドメインが差出人と不一致"
    description: "メールの電子署名は、差出人として表示されている組織とは別の事業者のものです。"

  - id: H13
    category: header
    score: 25
    label: "フリーメール差出人＋大量配信基盤"
    description: "個人向けメールアドレスを名乗っていますが、実際は企業向けの一斉配信サービスから送られています。"

  - id: H14
    category: header
    score: 10
    label: "SPF レコードなし（none）"
    description: "差出人のドメインには、送信元を検証する設定がされていません。"

  # H15 は enrich.py（OpenCTI 照会）が立てる。
  # Email-Addr の登録は約3,600件と少ないが、ヒットすれば確度は極めて高い
  - id: H15
    category: header
    score: 35
    label: "差出人アドレスが既知の攻撃者"
    description: "このメールアドレスは、過去の攻撃で使われたことが確認されています。"

  # ==================================================================
  # B. 本文・URL 系
  # ==================================================================
  # U01 は enrich.py（OpenCTI 照会）が立てる。
  # スコア90帯の実体は「攻撃用に作られたドメイン」より
  # 「侵害された正規サイト」が多く、侵害が解消されて現在は正常に
  # 戻っている可能性もあるため、単独では断定しない配点にしている
  - id: U01
    category: url
    score: 30
    label: "既知の悪性URL"
    description: "過去にフィッシングやマルウェア配布で使われたことが確認されているURLが含まれています。"

  - id: U02
    category: url
    score: 30
    label: "正規ドメインに酷似したURL"
    description: "本物のドメインに一文字だけ似せたURLが含まれています。見間違いを狙った手口です。"

  - id: U03
    category: url
    score: 35
    label: "IDNホモグラフ（異体字混入）"
    description: "見た目は通常のアルファベットですが、別の文字が混ぜられた偽のURLです。"

  - id: U04
    category: url
    score: 25
    label: "表示テキストとリンク先の不一致"
    description: "画面に表示されている文字と、実際のリンク先が異なります。"

  # U05 は enrich.py が WHOIS で判定する。
  # 外部への問い合わせが発生するため、既定では無効（opencti.enable_whois）
  - id: U05
    category: url
    score: 20
    label: "新規登録ドメイン（30日以内）"
    description: "つい最近作られたばかりのドメインです。攻撃用の使い捨てである可能性があります。"

  - id: U06
    category: url
    score: 15
    label: "短縮URL / オープンリダイレクタ"
    description: "本当のリンク先が隠されています。"

  - id: U07
    category: url
    score: 20
    label: "URLに認証情報が埋め込まれている"
    description: "正規サイトに見せかけるための古典的な偽装が使われています。"

  - id: U08
    category: url
    score: 10
    label: "差出人ドメインと本文URLが無関係"
    description: "差出人と、リンク先の運営者が一致していません。"

  # ==================================================================
  # C. 添付系
  # ==================================================================
  # A01 は enrich.py（OpenCTI 照会）が立てる。
  # ハッシュの完全一致は確度が高いが、即時悪性にはしない方針
  - id: A01
    category: attachment
    score: 40
    label: "既知マルウェアのハッシュ一致"
    description: "添付ファイルは既知のウイルスです。絶対に開かないでください。"

  - id: A02
    category: attachment
    score: 35
    label: "Officeマクロを含む"
    description: "開くだけでプログラムが動作する仕掛けが埋め込まれています。"

  - id: A03
    category: attachment
    score: 35
    label: "拡張子と実体の不一致"
    description: "ファイルの種類が偽装されています。文書を装った別の形式です。"

  - id: A04
    category: attachment
    score: 25
    label: "HTML添付"
    description: "開くと偽のログイン画面が表示される形式の添付です。"

  - id: A05
    category: attachment
    score: 25
    label: "PDF内のJavaScript/自動アクション"
    description: "PDFを開いた際に自動で動作する仕掛けが含まれています。"

  - id: A06
    category: attachment
    score: 20
    label: "パスワード付きアーカイブ"
    description: "ウイルス検査を回避するため、パスワードをかけて中身を隠しています。"

  - id: A07
    category: attachment
    score: 45
    label: "実行可能ファイル"
    description: "開くとプログラムが動作するファイルが添付されています。絶対に開かないでください。"

  - id: A08
    category: attachment
    score: 40
    label: "二重拡張子"
    description: "文書ファイルに見せかけたプログラムです。"

  # ==================================================================
  # D. 文脈系（LLM 判定）
  #
  # llm.py がローカル LLM(gemma3:4b) で判定する。
  # 配点は意図的に低め。LLM の判定は揺れうるため、単独で悪性に到達させない。
  # 合計しても80点で閾値100に届かず、必ずルールベースの検出が1つ以上必要。
  #
  # C01/C02 は実測を経て段階的に下げた（15/20 → 10/15 → 5/15）。
  # 正規のメールマガジンや、サービスのサインアップ確認メールでも
  # 該当してしまい、正規メールが「悪性」に昇格したため。
  # あわせて llm.py 側でも判定基準を「肯定形で狭く列挙」する方式に
  # 変更している（4B級モデルは除外条件を守らないため）。
  # ==================================================================

  # 当初15点 → 10点 → 5点。
  # "To complete your sign up, please verify your email" のような
  # 緊急性のない文面でも立ってしまい、グレー検体が100点ちょうど（悪性）に
  # 到達したため。閾値付近での1シグナルの有無が、報告者への通知内容を
  # 「担当者が確認します」から「絶対に開かないでください」へ
  # 変えてしまうのは避ける
  - id: C01
    category: context
    score: 5
    label: "過度な緊急性・脅迫"
    description: "「すぐに対応しないと停止する」など、慌てさせて判断を鈍らせる書き方がされています。"

  - id: C02
    category: context
    score: 15
    label: "認証情報の入力要求"
    description: "IDやパスワードの入力を求めています。正規の組織がメールでこれを求めることはありません。"

  # C03 は据え置き。正規メールで振込先変更を依頼することはまず無く、
  # BEC（ビジネスメール詐欺）の核心にあたるため。
  # ルールベースでは拾えない、LLM ならではの価値がある項目
  - id: C03
    category: context
    score: 30
    label: "振込先口座の変更依頼"
    description: "支払先の変更を求めています。ビジネスメール詐欺の典型的な手口です。"

  - id: C04
    category: context
    score: 10
    label: "不自然な日本語"
    description: "機械翻訳のような不自然な表現が使われています。"

  # C05 も据え置き。正規の組織が「内密に」と書くことは稀で、
  # 相談させないようにするのは詐欺の特徴
  - id: C05
    category: context
    score: 20
    label: "秘密保持の要求"
    description: "「この件は内密に」など、他の人に相談させないようにする記述があります。"

  # ==================================================================
  # E. 減点要素
  # 誤検知を減らすために不可欠。
  # 社内の定期通知が毎回「疑わしい」と判定されると、報告者の信頼を失う
  # ==================================================================
  - id: S01
    category: safe
    score: -40
    label: "DMARC pass かつ取引先ホワイトリスト"
    description: "信頼できる送信元として登録されているドメインからのメールです。"

  - id: S02
    category: safe
    score: -50
    label: "自組織の正規システムからの通知"
    description: "本学の正規のシステムから送信された通知です。"

  - id: S03
    category: safe
    score: -15
    label: "過去に正常判定された送信者"
    description: "以前にも同じ差出人から届いており、問題ないと判定されています。"
